# ---- VibeAudit configuration (copy to .env and fill in) ----

# local  = your own machine: folder, GitHub and Deep (Docker) scans; shared history.
# public = hosted for other people: pasted snippets only, rate limits, private expiring results.
APP_MODE=local

# Model API (any OpenAI-compatible endpoint). NVIDIA Integrate by default.
# LLM_API_KEY / LLM_BASE_URL are accepted as aliases (e.g. for OpenRouter).
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Nemotron's thinking switch; set false for providers that reject unknown fields.
SEND_THINKING_FLAG=true

# LLM behavior
ANALYSIS_TEMPERATURE=0.2
ANALYSIS_TOP_P=0.95
MAX_TOKENS=8192
ENABLE_THINKING=true
REQUEST_TIMEOUT=180
MAX_RETRIES=4

# Scan limits (tune for cost/speed)
MAX_CONCURRENCY=4
MAX_FILE_BYTES=120000
MAX_TOTAL_BYTES=5000000
MAX_FILES=40
MAX_ANALYSIS_UNITS=120
CHUNK_LINES=350
CHUNK_OVERLAP=30
MAX_CHUNKS_PER_FILE=6

# Features
ENABLE_DETERMINISTIC=true
ENABLE_VERIFICATION=true

# Dynamic analysis (Phase 4): on a "deep" scan, run the app in a Docker sandbox to catch
# build/boot/runtime errors. Needs Docker Desktop running; skipped gracefully if absent.
ENABLE_DYNAMIC=true
ENABLE_BROWSER_PROBE=true
DYNAMIC_TIMEOUT_S=180

# Snippet limits (both modes)
MAX_SNIPPET_LINES=400
MAX_SNIPPET_BYTES=20000
MAX_REQUEST_BYTES=64000

# Abuse & cost controls (public mode)
RATE_LIMIT_PER_HOUR=5
DAILY_SCAN_CAP=100
MAX_RUNNING_SCANS=2
# Only set true behind your own reverse proxy / load balancer (it trusts X-Forwarded-For).
TRUST_PROXY_HEADERS=false
SCAN_TIMEOUT_S=300

# Results
RESULT_TTL_HOURS=24
CACHE_TTL_HOURS=24
JOB_RETENTION_S=600
